# Server-side human-readable plugins (data/plugins/)
COMMAND: /portal
DESC: Spawn a standard cyberX87 portal gate to a local world (usage: /portal <world_name>)
ROLE: builder
ACTION: spawn_portal
VALUE: vrml://LOCAL/{args}
---
COMMAND: /fedportal
DESC: Spawn a federated portal gate to another server (usage: /fedportal <host:port/world>)
ROLE: admin
ACTION: spawn_portal
VALUE: vrml://{args}
---
COMMAND: /pillar
DESC: Spawn a glowing cyan pillar in front of you
ROLE: builder
ACTION: spawn_vrml
VALUE: Transform { translation {x} 2.0 {z_front} children [ Shape { appearance Appearance { material Material { diffuseColor 0.0 1.0 0.85 emissiveColor 0.0 0.7 0.6 } } geometry Cylinder { radius 0.5 height 4.0 } } ] }
---
COMMAND: /announce
DESC: Broadcast a server-wide banner message
ROLE: admin
ACTION: broadcast
VALUE: [ANNOUNCEMENT] {args}
